{
  "name": "@ferweb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/migrate.ts",
    "owner:create": "tsx src/provision.ts"
  },
  "dependencies": {
    "@ferweb/contracts": "0.1.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
