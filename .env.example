# Copy with `npm run setup` (generates the password without printing it).
# These settings are for local development. Never commit .env.
POSTGRES_DB=ferweb
POSTGRES_USER=ferweb
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Host connection for native development; Compose overrides PGHOST/PGPORT.
PGHOST=127.0.0.1
PGPORT=5432

# Ports published only on loopback. No database port in the default stack.
API_PORT=3001
WEB_PORT=5173

# Optional host port, used only by compose.native.yaml.
POSTGRES_PORT=5432

# File watching in Docker Desktop bind mounts. Set false if native events work.
WATCH_POLLING=true

# Simulated background worker, Docker only. SQL enforces global 2 / project 1.
JOB_WORKER_CONCURRENCY=2
# Lease range: 2000–30000 ms; heartbeat 500 ms, recovery grace 1000 ms.
JOB_WORKER_LEASE_MS=5000

# Generado por npm run setup. Solo API, worker y controlador; nunca el sandbox.
RUNNER_SERVICE_TOKEN=replace-with-a-random-runner-token

# Optional browser origin. Defaults to http://127.0.0.1:<WEB_PORT>.
# Set explicitly if opening via localhost or another allowed development origin.
# APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false

# Private Node/Python service authentication. Generated by npm run setup.
AI_SERVICE_TOKEN=replace-with-a-random-internal-token
# Internal derived vector cache. Docker supplies this value; no host port is published.
# QDRANT_URL=http://qdrant:6333

# GitHub App credentials live only in a private server-side JSON file.
# The Docker manager auto-detects secrets/github-app.json; see docs/github.md.
# To select another file, set FERWEB_GITHUB_CONFIG_FILE in the shell.

# Release uses its own .env.release, generated by npm run release:setup.
# Do not reuse the development volume automatically. See docs/deployment.md.
# METRICS_TOKEN=<private random token, internal metrics only>
# FERWEB_RELEASE_TAG=candidate
# SOURCE_DATE_EPOCH=0
